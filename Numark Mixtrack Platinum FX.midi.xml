<?xml version="1.0" encoding="UTF-8"?>
<MixxxControllerPreset schemaVersion="1" mixxxVersion="2.3.0+">
  <info>
    <name>Numark Mixtrack Platinum FX</name>
    <author>
      Johan JANIN, based on the work of QGazQ, Octopussy, h67ma, bad1dea5, photoenix, Matthew
      Nicholson, Ending &amp; Kaj Bostrom
    </author>
    <description>
      Mapping for the Numark Mixtrack Platinum FX.

      Repository : https://github.com/johan-jnn/Numark-MixtrackPlatinumFX-mixxx
      Personnal Website : https://johan-janin.com
    </description>
    <forums>https://mixxx.discourse.group/t/numark-mixtrack-platinum-fx-mapping/19985</forums>
  </info>
  <controller id="MixTrack Platinum FX">
    <scriptfiles>
      <file filename="lodash.mixxx.js" />
      <file filename="midi-components-0.0.js" />
      <file functionprefix="MixtrackPlatinumFX" filename="Numark-Mixtrack-Platinum-FX-scripts.js" />
    </scriptfiles>

    <controls>
      <!-- #region DIRECT MAPPING -->
      <control for="Main Gain">
        <group>[Master]</group>
        <key>gain</key>
        <status>0xBE</status>
        <midino>0x23</midino>
        <options>
          <normal />
        </options>
      </control>
      <control for="Crossfader (Left Deck)">
        <group>[Master]</group>
        <key>crossfader</key>
        <status>0xBF</status>
        <midino>0x08</midino>
        <options>
          <normal />
        </options>
      </control>

      <!-- Headphones -->
      <control for="Headphone Gain">
        <group>[Master]</group>
        <key>headGain</key>
        <status>0xBF</status>
        <midino>0x0C</midino>
        <options>
          <normal />
        </options>
      </control>
      <control for="Headphone Mix">
        <group>[Master]</group>
        <key>headMix</key>
        <status>0xBF</status>
        <midino>0x0D</midino>
        <options>
          <normal />
        </options>
      </control>

      <!-- FX Dry/Wet Knobs -->
      <control for="FX Unit 1 Dry/Wet Knob">
        <group>[EffectRack1_EffectUnit1]</group>
        <key>mix</key>
        <status>0xB8</status>
        <midino>0x04</midino>
        <options>
          <normal />
        </options>
      </control>
      <control for="FX Unit 2 Dry/Wet Knob">
        <group>[EffectRack1_EffectUnit2]</group>
        <key>mix</key>
        <status>0xB9</status>
        <midino>0x04</midino>
        <options>
          <normal />
        </options>
      </control>
      <control for="FX Unit 3 Dry/Wet Knob">
        <group>[EffectRack1_EffectUnit3]</group>
        <key>mix</key>
        <status>0xB8</status>
        <midino>0x04</midino>
        <options>
          <normal />
        </options>
      </control>
      <control for="FX Unit 4 Dry/Wet Knob">
        <group>[EffectRack1_EffectUnit4]</group>
        <key>mix</key>
        <status>0xB9</status>
        <midino>0x04</midino>
        <options>
          <normal />
        </options>
      </control>
      <!-- #endregion -->

      <!-- #region SCRIPT MAPPING -->
      <!-- #region Shifting -->
      <control for="Left Shift">
        <group>[Master]</group>
        <key>MixtrackPlatinumFX.shift</key>
        <status>0x90</status>
        <midino>0x20</midino>
        <options>
          <script-binding />
        </options>
      </control>
      <control for="Left Unshift">
        <group>[Master]</group>
        <key>MixtrackPlatinumFX.unshift</key>
        <status>0x80</status>
        <midino>0x20</midino>
        <options>
          <script-binding />
        </options>
      </control>
      <control for="Right Shift">
        <group>[Master]</group>
        <key>MixtrackPlatinumFX.shift</key>
        <status>0x91</status>
        <midino>0x20</midino>
        <options>
          <script-binding />
        </options>
      </control>
      <control for="Right Unshift">
        <group>[Master]</group>
        <key>MixtrackPlatinumFX.unshift</key>
        <status>0x81</status>
        <midino>0x20</midino>
        <options>
          <script-binding />
        </options>
      </control>
      <!-- #endregion -->

      <!-- #region FX Pad -->
      <control for="HPF Button">
        <group>[EffectRack1_EffectUnit1_Effect1]</group>
        <key>MixtrackPlatinumFX.$components.effects.pad[1][1].input</key>
        <status>0x98</status>
        <midino>0x00</midino>
        <options>
          <script-binding />
        </options>
      </control>
      <control for="HPF Button (release)">
        <group>[EffectRack1_EffectUnit1_Effect1]</group>
        <key>MixtrackPlatinumFX.$components.effects.pad[1][1].input</key>
        <status>0x88</status>
        <midino>0x00</midino>
        <options>
          <script-binding />
        </options>
      </control>
      <control for="LPF Button">
        <group>[EffectRack1_EffectUnit1_Effect2]</group>
        <key>MixtrackPlatinumFX.$components.effects.pad[1][2].input</key>
        <status>0x98</status>
        <midino>0x01</midino>
        <options>
          <script-binding />
        </options>
      </control>
      <control for="LPF Button (release)">
        <group>[EffectRack1_EffectUnit1_Effect2]</group>
        <key>MixtrackPlatinumFX.$components.effects.pad[1][2].input</key>
        <status>0x88</status>
        <midino>0x01</midino>
        <options>
          <script-binding />
        </options>
      </control>
      <control for="Flanger Button">
        <group>[EffectRack1_EffectUnit1_Effect3]</group>
        <key>MixtrackPlatinumFX.$components.effects.pad[1][3].input</key>
        <status>0x98</status>
        <midino>0x02</midino>
        <options>
          <script-binding />
        </options>
      </control>
      <control for="Flanger Button (release)">
        <group>[EffectRack1_EffectUnit1_Effect3]</group>
        <key>MixtrackPlatinumFX.$components.effects.pad[1][3].input</key>
        <status>0x88</status>
        <midino>0x02</midino>
        <options>
          <script-binding />
        </options>
      </control>
      <control for="Echo Button">
        <group>[EffectRack1_EffectUnit2_Effect1]</group>
        <key>MixtrackPlatinumFX.$components.effects.pad[2][1].input</key>
        <status>0x99</status>
        <midino>0x03</midino>
        <options>
          <script-binding />
        </options>
      </control>
      <control for="Echo Button (release)">
        <group>[EffectRack1_EffectUnit2_Effect1]</group>
        <key>MixtrackPlatinumFX.$components.effects.pad[2][1].input</key>
        <status>0x89</status>
        <midino>0x03</midino>
        <options>
          <script-binding />
        </options>
      </control>
      <control for="Reverb Button">
        <group>[EffectRack1_EffectUnit2_Effect2]</group>
        <key>MixtrackPlatinumFX.$components.effects.pad[2][2].input</key>
        <status>0x99</status>
        <midino>0x04</midino>
        <options>
          <script-binding />
        </options>
      </control>
      <control for="Reverb Button (release)">
        <group>[EffectRack1_EffectUnit2_Effect2]</group>
        <key>MixtrackPlatinumFX.$components.effects.pad[2][2].input</key>
        <status>0x89</status>
        <midino>0x04</midino>
        <options>
          <script-binding />
        </options>
      </control>
      <control for="Phaser Button">
        <group>[EffectRack1_EffectUnit2_Effect3]</group>
        <key>MixtrackPlatinumFX.$components.effects.pad[2][3].input</key>
        <status>0x99</status>
        <midino>0x05</midino>
        <options>
          <script-binding />
        </options>
      </control>
      <control for="Phaser Button (release)">
        <group>[EffectRack1_EffectUnit2_Effect3]</group>
        <key>MixtrackPlatinumFX.$components.effects.pad[2][3].input</key>
        <status>0x89</status>
        <midino>0x05</midino>
        <options>
          <script-binding />
        </options>
      </control>
      <!-- #endregion -->

      <!-- FX Senders -->
      <control for="Deck 1 FX Sender">
        <group>[EffectRack1]</group>
        <key>MixtrackPlatinumFX.$components.effects.senders[1].input</key>
        <status>0xB8</status>
        <midino>0x03</midino>
        <options>
          <script-binding />
        </options>
      </control>
      <control for="Deck 2 Deck FX Sender">
        <group>[EffectRack1]</group>
        <key>MixtrackPlatinumFX.$components.effects.senders[2].input</key>
        <status>0xB9</status>
        <midino>0x03</midino>
        <options>
          <script-binding />
        </options>
      </control>

      <!-- FX Beats -->
      <control for="FX Beats">
        <group>[EffectRack1]</group>
        <key>MixtrackPlatinumFX.$components.effects.beats.input</key>
        <status>0xB8</status>
        <midino>0x05</midino>
        <options>
          <script-binding />
        </options>
      </control>
      <!-- #region Deck selection -->
      <control for="Channel 1 deck switch">
        <group>[Channel1]</group>
        <key>MixtrackPlatinumFX.$components.decks[1].switch</key>
        <status>0x90</status>
        <midino>0x08</midino>
        <options>
          <script-binding />
        </options>
      </control>
      <control for="Channel 2 deck switch">
        <group>[Channel2]</group>
        <key>MixtrackPlatinumFX.$components.decks[2].switch</key>
        <status>0x91</status>
        <midino>0x08</midino>
        <options>
          <script-binding />
        </options>
      </control>
      <control for="Channel 3 deck switch">
        <group>[Channel3]</group>
        <key>MixtrackPlatinumFX.$components.decks[1].switch</key>
        <status>0x92</status>
        <midino>0x08</midino>
        <options>
          <script-binding />
        </options>
      </control>
      <control for="Channel 4 deck switch">
        <group>[Channel4]</group>
        <key>MixtrackPlatinumFX.$components.decks[2].switch</key>
        <status>0x93</status>
        <midino>0x08</midino>
        <options>
          <script-binding />
        </options>
      </control>
      <!-- #endregion -->
      <!-- #endregion -->
    </controls>
    <outputs>
      <!-- PFLs -->
      <output>
        <group>[Channel1]</group>
        <key>pfl</key>
        <status>0x90</status>
        <midino>0x1B</midino>
        <minimum>0.5</minimum>
      </output>
      <output>
        <group>[Channel2]</group>
        <key>pfl</key>
        <status>0x91</status>
        <midino>0x1B</midino>
        <minimum>0.5</minimum>
      </output>
      <output>
        <group>[Channel3]</group>
        <key>pfl</key>
        <status>0x92</status>
        <midino>0x1B</midino>
        <minimum>0.5</minimum>
      </output>
      <output>
        <group>[Channel4]</group>
        <key>pfl</key>
        <status>0x93</status>
        <midino>0x1B</midino>
        <minimum>0.5</minimum>
      </output>
    </outputs>
  </controller>
</MixxxControllerPreset>